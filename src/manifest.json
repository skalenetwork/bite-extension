{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "name": "MyBITE Wallet",
  "description": "Confidential token viewer key manager for SKALE BITE protocol",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "64": "images/icon.png",
    "128": "images/icon.png"
  },
  "chromium:action": {
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "64": "images/icon.png",
      "128": "images/icon.png"
    },
    "default_title": "MyBITE Wallet"
  },
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "64": "images/icon.png",
      "128": "images/icon.png"
    },
    "default_title": "MyBITE Wallet"
  },
  "chromium:side_panel": {
    "default_path": "sidebar/index.html",
    "default_title": "MyBITE Wallet"
  },
  "firefox:sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "MyBITE Wallet"
  },
  "chromium:permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "firefox:permissions": [
    "storage",
    "activeTab"
  ],
  "chromium:host_permissions": [
    "https://base-sepolia-testnet.skalenodes.com/*"
  ],
  "background": {
    "chromium:service_worker": "background.js",
    "firefox:scripts": [
      "background.js"
    ]
  },
  "content_security_policy": {
    "chromium:extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "firefox:content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [],
  "author": "TheGreatAxios"
}
